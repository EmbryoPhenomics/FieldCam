(ftf
  (header
    (version 2.0)
    (unit DBUNIT)
  )
  (TechnologyContainer
    (technology SamacSys_Footprint
      (footprintLayer
        (layer Top (type Conductive))
        (layer Inner (type Conductive))
        (layer Bottom (type Conductive))
        (layer Silk-Top (type Symbolmark))
        (layer Silk-Bottom (type Symbolmark))
        (layer Resist-Top (type Solderresist))
        (layer Resist-Bottom (type Solderresist))
        (layer MetalMask-Top (type Metalmask))
        (layer MetalMask-Bottom (type Metalmask))
        (layer CompArea-Top (type Comparea))
        (layer CompArea-Bottom (type Comparea))
        (layer Assembly-Top (type Undefined))
        (layer Assembly-Bottom (type Undefined))
        (layer Hole (type Hole))
      )
    )
  )
  (footprintContainer
    (commonParameters
      (dimensionParameters
        (arrowLength 100000)
        (arrowAngle 15.000000)
        (dotDiameter 100000)
        (textFrameOffset 100000)
        (arrowOffset 100000)
        (dimAssistOffset 100000)
        (dimLineWidth 10000)
        (drawTextFrame NO)
        (textFrameRange ALL)
        (textClip NO)
        (standard JIS)
      )
    )
    (padstackGroups
      (padstackGroup default)
    )
    (pads
      (pad r325_150
        (photo FLASH)
        (panelUse NO)
        (geometry
          (rectangle
            (pt 0 0)
            (width 150000)
            (height 325000)
            (rAngle 0.000000)
            (outlineWidth 0)
            (fillWidth 0)
            (fillAngle 0.000000)
          )
        )
      )
      (pad r110_55
        (photo FLASH)
        (panelUse NO)
        (geometry
          (rectangle
            (pt 0 0)
            (width 55000)
            (height 110000)
            (rAngle 0.000000)
            (outlineWidth 0)
            (fillWidth 0)
            (fillAngle 0.000000)
          )
        )
      )
      (pad r110_50
        (photo FLASH)
        (panelUse NO)
        (geometry
          (rectangle
            (pt 0 0)
            (width 50000)
            (height 110000)
            (rAngle 0.000000)
            (outlineWidth 0)
            (fillWidth 0)
            (fillAngle 0.000000)
          )
        )
      )
      (pad c37.5
        (photo FLASH)
        (panelUse NO)
        (geometry
          (circle 18750
            (pt 0 0)
          )
        )
      )
    ); End of pads
    (padstacks
      (padstack r325_150
        (type NONPLATED)
        (throughMode NONTHROUGH)
        (panelUse NO)
        (padSet (footLayer Top)
          (connect (pad r325_150))
          (noconnect (pad r325_150))
        )
        (padSet (footLayer Resist-Top)
          (connect (pad r325_150))
          (noconnect (pad r325_150))
        )
        (padSet (footLayer MetalMask-Top)
          (connect (pad r325_150))
          (noconnect (pad r325_150))
        )
      )
      (padstack r110_55
        (type NONPLATED)
        (throughMode NONTHROUGH)
        (panelUse NO)
        (padSet (footLayer Top)
          (connect (pad r110_55))
          (noconnect (pad r110_55))
        )
        (padSet (footLayer Resist-Top)
          (connect (pad r110_55))
          (noconnect (pad r110_55))
        )
        (padSet (footLayer MetalMask-Top)
          (connect (pad r110_55))
          (noconnect (pad r110_55))
        )
      )
      (padstack r110_55
        (type NONPLATED)
        (throughMode NONTHROUGH)
        (panelUse NO)
        (padSet (footLayer Top)
          (connect (pad r110_55))
          (noconnect (pad r110_55))
        )
        (padSet (footLayer Resist-Top)
          (connect (pad r110_55))
          (noconnect (pad r110_55))
        )
        (padSet (footLayer MetalMask-Top)
          (connect (pad r110_55))
          (noconnect (pad r110_55))
        )
      )
      (padstack r110_55
        (type NONPLATED)
        (throughMode NONTHROUGH)
        (panelUse NO)
        (padSet (footLayer Top)
          (connect (pad r110_55))
          (noconnect (pad r110_55))
        )
        (padSet (footLayer Resist-Top)
          (connect (pad r110_55))
          (noconnect (pad r110_55))
        )
        (padSet (footLayer MetalMask-Top)
          (connect (pad r110_55))
          (noconnect (pad r110_55))
        )
      )
      (padstack r110_50
        (type NONPLATED)
        (throughMode NONTHROUGH)
        (panelUse NO)
        (padSet (footLayer Top)
          (connect (pad r110_50))
          (noconnect (pad r110_50))
        )
        (padSet (footLayer Resist-Top)
          (connect (pad r110_50))
          (noconnect (pad r110_50))
        )
        (padSet (footLayer MetalMask-Top)
          (connect (pad r110_50))
          (noconnect (pad r110_50))
        )
      )
      (padstack r110_50
        (type NONPLATED)
        (throughMode NONTHROUGH)
        (panelUse NO)
        (padSet (footLayer Top)
          (connect (pad r110_50))
          (noconnect (pad r110_50))
        )
        (padSet (footLayer Resist-Top)
          (connect (pad r110_50))
          (noconnect (pad r110_50))
        )
        (padSet (footLayer MetalMask-Top)
          (connect (pad r110_50))
          (noconnect (pad r110_50))
        )
      )
      (padstack r110_50
        (type NONPLATED)
        (throughMode NONTHROUGH)
        (panelUse NO)
        (padSet (footLayer Top)
          (connect (pad r110_50))
          (noconnect (pad r110_50))
        )
        (padSet (footLayer Resist-Top)
          (connect (pad r110_50))
          (noconnect (pad r110_50))
        )
        (padSet (footLayer MetalMask-Top)
          (connect (pad r110_50))
          (noconnect (pad r110_50))
        )
      )
      (padstack c37.5h75
        (type PLATED)
        (throughMode THROUGH)
        (panelUse NO)
        (Hole (footLayer Hole)
          (geometry
            (circle 37500
              (pt 0 0)
            )
          )
        )
        (padSet (footLayer Top)
          (connect (pad c37.5))
          (noconnect (pad c37.5))
        )
        (padSet (footLayer Resist-Top)
          (connect (pad c37.5))
          (noconnect (pad c37.5))
        )
        (padSet (footLayer Resist-Bottom)
          (connect (pad c37.5))
          (noconnect (pad c37.5))
        )
        (padSet (footLayer Inner)
          (clearance (pad c37.5))
          (connect (pad c37.5))
          (noconnect (pad c37.5))
        )
        (padSet (footLayer Bottom)
          (connect (pad c37.5))
          (noconnect (pad c37.5))
        )
      )
    ); End of padstacks
    (footprints
      (footprint "16129011"
        (polarity YES)
        (panelUse NO)
        (heelprint
          (layout
            (layer (footLayer Assembly-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt -400000 -200000
                        (width 10000)
                      )
                      (pt 400000 -200000
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Assembly-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt 400000 -200000
                        (width 10000)
                      )
                      (pt 400000 200000
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Assembly-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt 400000 200000
                        (width 10000)
                      )
                      (pt -400000 200000
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Assembly-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt -400000 200000
                        (width 10000)
                      )
                      (pt -400000 -200000
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer CompArea-Top)
              (area
                (geometry
                  (surface
                    (outlineWidth 0)
                    (fillWidth 0)
                    (fillAngle 0.000000)
                    (vertex
                    (pt 507500 315000)
                    (pt 507500 -315000)
                    (pt -507500 -315000)
                    (pt -507500 315000)
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt -280000 200000
                        (width 20000)
                      )
                      (pt -400000 200000
                        (width 20000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt -400000 200000
                        (width 20000)
                      )
                      (pt -400000 -2500
                        (width 20000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt -400000 -120000
                        (width 20000)
                      )
                      (pt -400000 -200000
                        (width 20000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt -400000 -200000
                        (width 20000)
                      )
                      (pt -280000 -200000
                        (width 20000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt 280000 -200000
                        (width 20000)
                      )
                      (pt 400000 -200000
                        (width 20000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt 400000 -200000
                        (width 20000)
                      )
                      (pt 400000 -120000
                        (width 20000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt 400000 -2500
                        (width 20000)
                      )
                      (pt 400000 200000
                        (width 20000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt 400000 200000
                        (width 20000)
                      )
                      (pt 280000 200000
                        (width 20000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt -440000 0
                        (width 10000)
                      )
                      (pt -440000 0
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (arc CCW
                        (r 5000)
                        (begin
                          (pt -440000 0
                            (width 10000)
                          )
                        )
                        (center -1073741824 0)
                        (end
                          (pt -450000 0
                            (width 10000)
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (arc CCW
                        (r 5000)
                        (begin
                          (pt -450000 0
                            (width 10000)
                          )
                        )
                        (center 1073741824 0)
                        (end
                          (pt -440000 0
                            (width 10000)
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
           ); End of layout
         ); End of heelprint
         (toeprint
          (pin 1
            (pt -200000 -2500)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt -200000 -2500)
                  (angle 0)
                  (padstackGroup default (padstack r325_150))
                )
              )
            )
          )
          (pin 2
            (pt 0 -2500)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt 0 -2500)
                  (angle 0)
                  (padstackGroup default (padstack r325_150))
                )
              )
            )
          )
          (pin 3
            (pt 200000 -2500)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt 200000 -2500)
                  (angle 0)
                  (padstackGroup default (padstack r325_150))
                )
              )
            )
          )
          (pin 4
            (pt -200000 187500)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt -200000 187500)
                  (angle 90)
                  (padstackGroup default (padstack r110_55))
                )
              )
            )
          )
          (pin 5
            (pt 0 187500)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt 0 187500)
                  (angle 90)
                  (padstackGroup default (padstack r110_55))
                )
              )
            )
          )
          (pin 6
            (pt 200000 187500)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt 200000 187500)
                  (angle 90)
                  (padstackGroup default (padstack r110_55))
                )
              )
            )
