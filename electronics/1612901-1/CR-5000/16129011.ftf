                  (angle 90)
                  (padstackGroup default (padstack c37.5h75))
                )
              )
            )
          )
        ); End of toeprint
        (propertyS accurateShape 1612901-1.stp)
      ); End of footprint
    ); End of footprints
  );  End of footprintContainer
); End of ftf

